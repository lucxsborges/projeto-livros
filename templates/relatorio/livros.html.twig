{% extends 'base.html.twig' %}

{% block title %}Relatório de livros por autor{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Relatório de livros por autor</h1>
            <p class="text-muted mb-0">
                Relação de livros agrupados por autor.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="{{ path('app_relatorio_livros_pdf') }}" class="btn btn-danger" target="_blank" rel="noopener">
                Gerar PDF
            </a>

            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                Imprimir
            </button>
        </div>
    </div>

    {% for autor in autores %}
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">
                <h2 class="h5 mb-0">
                    {{ autor.nome }}
                </h2>
            </div>

            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Editora</th>
                                <th>Edição</th>
                                <th>Ano</th>
                                <th>Valor</th>
                                <th>Assuntos</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for livro in autor.livros %}
                                <tr>
                                    <td>{{ livro.titulo }}</td>
                                    <td>{{ livro.editora }}</td>
                                    <td>{{ livro.edicao }}ª</td>
                                    <td>{{ livro.ano }}</td>
                                    <td class="text-nowrap">
                                        R$ {{ livro.valor|number_format(2, ',', '.') }}
                                    </td>
                                    <td>
                                        {% for assunto in livro.assuntos %}
                                            <span class="badge bg-secondary me-1 mb-1">
                                                {{ assunto }}
                                            </span>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endfor %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            Nenhum livro encontrado para o relatório.
        </div>
    {% endfor %}
{% endblock %}