{% extends 'base.html.twig' %}

{% block title %}Início{% endblock %}

{% block body %}
    <div class="mb-4">
        <h1 class="h2 fw-bold">Gerenciamento de Livros</h1>
        <p class="text-muted">
            Bem-vindo ao sistema de gerenciamento da biblioteca.
            Utilize as opções abaixo para acessar as funcionalidades.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Livros</h5>

                    <p class="card-text text-muted">
                        Cadastre, consulte, edite e exclua livros,
                        vinculando autores e assuntos.
                    </p>

                    <a href="{{ path('app_livro_index') }}"
                       class="btn btn-primary mt-auto">
                        Acessar Livros
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Autores</h5>

                    <p class="card-text text-muted">
                        Gerencie os autores cadastrados
                        e suas informações.
                    </p>

                    <a href="{{ path('app_autor_index') }}"
                       class="btn btn-primary mt-auto">
                        Acessar Autores
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Assuntos</h5>

                    <p class="card-text text-muted">
                        Cadastre e gerencie os assuntos
                        utilizados na classificação dos livros.
                    </p>

                    <a href="{{ path('app_assunto_index') }}"
                       class="btn btn-primary mt-auto">
                        Acessar Assuntos
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Relatório</h5>

                    <p class="card-text text-muted">
                        Visualize os livros agrupados por autor
                        e gere relatórios em PDF.
                    </p>

                    <a href="{{ path('app_relatorio_livros') }}"
                       class="btn btn-success mt-auto">
                        Acessar Relatório
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}