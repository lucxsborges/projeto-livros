
{% extends 'base.html.twig' %}

{% block title %}Visualizar livro{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="h3 mb-4">Visualizar livro</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered align-middle">
                <tbody>
                    <tr>
                        <th style="width: 200px;">Código</th>
                        <td>{{ livro.codl }}</td>
                    </tr>

                    <tr>
                        <th>Título</th>
                        <td>{{ livro.titulo }}</td>
                    </tr>

                    <tr>
                        <th>Editora</th>
                        <td>{{ livro.editora }}</td>
                    </tr>

                    <tr>
                        <th>Edição</th>
                        <td>{{ livro.edicao }}ª edição</td>
                    </tr>

                    <tr>
                        <th>Ano de publicação</th>
                        <td>{{ livro.anoPublicacao }}</td>
                    </tr>

                    <tr>
                        <th>Valor</th>
                        <td>
                            R$ {{ livro.valor|number_format(2, ',', '.') }}
                        </td>
                    </tr>

                    <tr>
                        <th>Autores</th>
                        <td>
                            {% for autor in livro.autores %}
                                <span class="badge bg-primary me-1">
                                    {{ autor.nome }}
                                </span>
                            {% else %}
                                <span class="text-muted">
                                    Nenhum autor associado
                                </span>
                            {% endfor %}
                        </td>
                    </tr>

                    <tr>
                        <th>Assuntos</th>
                        <td>
                            {% for assunto in livro.assuntos %}
                                <span class="badge bg-secondary me-1">
                                    {{ assunto.descricao }}
                                </span>
                            {% else %}
                                <span class="text-muted">
                                    Nenhum assunto associado
                                </span>
                            {% endfor %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex gap-2 mt-4">
                <a href="{{ path('app_livro_index') }}"
                   class="btn btn-secondary">
                    Voltar
                </a>

                <a href="{{ path('app_livro_edit', {
                    'codl': livro.codl
                }) }}" class="btn btn-primary">
                    Editar
                </a>

                <div class="ms-auto">
                    {{ include('livro/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
