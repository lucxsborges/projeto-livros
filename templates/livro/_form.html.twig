
{{ form_start(form) }}
    <div class="row">
        <div class="col-md-8 mb-3">
            {{ form_row(form.titulo) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_row(form.editora) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_row(form.edicao) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_row(form.anoPublicacao) }}
        </div>

        <div class="col-md-4 mb-3">
            {{ form_row(form.valor) }}
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    Autores
                </div>
                <div class="card-body">
                    {{ form_row(form.autores, {'label': false}) }}
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-header">
                    Assuntos
                </div>
                <div class="card-body">
                    {{ form_row(form.assuntos, {'label': false}) }}
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            {{ button_label|default('Salvar') }}
        </button>

        <a href="{{ path('app_livro_index') }}"
        class="btn btn-secondary">
            Cancelar
        </a>
    </div>
{{ form_end(form) }}


<script>
document.addEventListener('DOMContentLoaded', function () {
    const campoValor = document.querySelector('.valor-monetario');

    if (!campoValor) return;

    function formatarValor(valor) {
        // Remove tudo que não for número
        let numeros = valor.replace(/\D/g, '');

        // Limita a 8 dígitos inteiros + 2 decimais
        numeros = numeros.slice(0, 10);

        if (numeros === '') return '';

        // Remove zeros à esquerda
        numeros = numeros.replace(/^0+/, '') || '0';

        // Separa os dois últimos dígitos como centavos
        numeros = numeros.padStart(3, '0');

        const reais = numeros.slice(0, -2);
        const centavos = numeros.slice(-2);

        return reais + ',' + centavos;
    }

    campoValor.addEventListener('input', function () {
        this.value = formatarValor(this.value);
    });
});
</script>