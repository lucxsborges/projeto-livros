
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        {% block title %}Biblioteca{% endblock %}
        | Biblioteca
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-light">
    {% set rotaAtual = app.request.attributes.get('_route')|default('') %}

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
                Biblioteca
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav ms-auto gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link {{ rotaAtual == 'app_home' ? 'active' : '' }}"
                            href="{{ path('app_home') }}"
                            {{ rotaAtual == 'app_home' ? 'aria-current="page"' : '' }}>Início
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{ rotaAtual starts with 'app_livro_' ? 'active' : '' }}"
                            href="{{ path('app_livro_index') }}"
                            {{ rotaAtual starts with 'app_livro_' ? 'aria-current="page"' : '' }}>Livros
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{ rotaAtual starts with 'app_autor_' ? 'active' : '' }}"
                            href="{{ path('app_autor_index') }}"
                            {{ rotaAtual starts with 'app_autor_' ? 'aria-current="page"' : '' }}>Autores
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{ rotaAtual starts with 'app_assunto_' ? 'active' : '' }}"
                            href="{{ path('app_assunto_index') }}"
                            {{ rotaAtual starts with 'app_assunto_' ? 'aria-current="page"' : '' }}>Assuntos
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {{ rotaAtual starts with 'app_relatorio_' ? 'active' : '' }}"
                            href="{{ path('app_relatorio_livros') }}"
                            {{ rotaAtual starts with 'app_relatorio_' ? 'aria-current="page"' : '' }}>Relatório
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        {# Mensagens de sucesso, erro e aviso #}
        {% for tipo, mensagens in app.flashes %}
            {% set classe = {
                'success': 'success',
                'error': 'danger',
                'danger': 'danger',
                'warning': 'warning',
                'info': 'info'
            }[tipo]|default('info') %}

            {% for mensagem in mensagens %}
                <div class="alert alert-{{ classe }} alert-dismissible fade show" role="alert"> {{ mensagem }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="border-top bg-white py-3 mt-5">
        <div class="container text-center text-muted small">
            Sistema de gerenciamento de livros
        </div>
    </footer>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
