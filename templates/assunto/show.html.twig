{% extends 'base.html.twig' %}

{% block title %}Visualizar assunto{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="h3 mb-4">Visualizar assunto</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 180px;">Código</th>
                        <td>{{ assunto.codAs }}</td>
                    </tr>
                    <tr>
                        <th>Descrição</th>
                        <td>{{ assunto.descricao }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex gap-2">
                <a href="{{ path('app_assunto_index') }}"
                   class="btn btn-secondary">Voltar</a>

                <a href="{{ path('app_assunto_edit', {'codAs': assunto.codAs}) }}" class="btn btn-primary">Editar</a>

                <div class="ms-auto">
                    {{ include('assunto/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
