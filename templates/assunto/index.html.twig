{% extends 'base.html.twig' %}

{% block title %}Assuntos{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Assuntos</h1>

        <a href="{{ path('app_assunto_new') }}" class="btn btn-primary">Novo assunto</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Descrição</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for assunto in assuntos %}
                        <tr>
                            <td>{{ assunto.codAs }}</td>
                            <td>{{ assunto.descricao }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_assunto_show', {'codAs': assunto.codAs}) }}" class="btn btn-sm btn-outline-info">
                                    Visualizar
                                </a>

                                <a href="{{ path('app_assunto_edit', {'codAs': assunto.codAs}) }}" class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Nenhum assunto cadastrado.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}